<Window x:Class="EduMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduMaster.App"
        mc:Ignorable="d"
        Title="EduMaster · 화학 문제 스튜디오" Height="900" Width="1320" MinHeight="660" MinWidth="980"
        Background="#F4F6FA" FontFamily="맑은 고딕" FontSize="14" Foreground="#17243A" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#34445E"/>
            <Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="Background" Value="#FBFCFE"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Margin" Value="0,6,0,16"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#142238" Padding="28,0"><DockPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><Border Background="#37CFAD" CornerRadius="9" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="E" FontWeight="Bold" FontSize="22" Foreground="#142238"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="EduMaster" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="화학 문제 스튜디오" Foreground="#A7B7CB" FontSize="11"/></StackPanel></StackPanel>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="AI 설정" Background="#24364D" Foreground="White" Click="SettingsClick"/>
        </DockPanel></Border>
        <Grid Grid.Row="1" Margin="28,22,28,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18"><TextBlock Text="내 샘플 파일을 넣고, 변형 문제를 확인하세요" FontSize="25" FontWeight="Bold"/><TextBlock Text="파일 선택 → 인식 본문 확인 → 변형 문제 생성. 본문에 생성할 문제 한 개만 남겨 주세요." Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Background="#FFF7E3" BorderBrush="#F4DA9A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18"><TextBlock x:Name="AiNotice" Text="로컬 Gemma 4 12B · API 키 없이 현재 PC에서 생성합니다. 사진·PDF의 인식 본문은 확인·수정해 주세요." Foreground="#886014" FontSize="12" TextWrapping="Wrap"/></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="12"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="22,18"><DockPanel><TextBlock Text="01  기준 자료" FontWeight="Bold" FontSize="17"/><TextBlock Text="INPUT" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/></DockPanel></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,18">
                        <Border x:Name="FileDropArea" AllowDrop="True" DragOver="FileDragOver" Drop="FileDrop" Background="#EDF8F4" BorderBrush="#A9DACC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18"><StackPanel>
                            <WrapPanel><Button x:Name="ImportButton" Content="샘플 파일 선택" Click="ImportClick" FontWeight="Bold"/><Button x:Name="OpenSourceButton" Content="원본 열기" Click="OpenSourceClick" IsEnabled="False"/><Button Content="초기화" Click="ResetClick"/></WrapPanel>
                            <TextBlock x:Name="FileNameText" Text="파일을 여기로 끌어 놓아도 됩니다" FontWeight="SemiBold" Margin="0,10,0,5" TextWrapping="Wrap"/>
                            <TextBlock Text="PDF(5페이지까지) · PNG · JPG · TXT · DOCX / 최대 10MB&#10;HWP, 그림·수식이 있는 Word 문서는 PDF로 저장해 주세요." FontSize="11" Foreground="#52627A" TextWrapping="Wrap"/>
                            <Image x:Name="SourceImage" MaxHeight="160" Stretch="Uniform" Visibility="Collapsed" Margin="0,12,0,0"/>
                        </StackPanel></Border>
                        <TextBlock Text="문제 제목" Style="{StaticResource Label}"/><TextBox x:Name="TitleInput" MaxLength="200" TextChanged="InputChanged"/>
                        <TextBlock Text="넣은 자료" Style="{StaticResource Label}"/><ComboBox x:Name="MaterialKindInput" SelectedIndex="0" SelectionChanged="MaterialKindChanged" Margin="0,6,0,16" Padding="10"><ComboBoxItem Content="문제 → 변형 문제 만들기"/><ComboBoxItem Content="풀이·해설 → 새 문제 만들기"/></ComboBox>
                        <TextBlock x:Name="BodyLabel" Text="문제 본문 (직접 붙여 넣기도 가능)" Style="{StaticResource Label}"/><TextBox x:Name="BodyInput" MinHeight="120" VerticalContentAlignment="Top" AcceptsReturn="True" MaxLength="12000" TextChanged="InputChanged"/>
                        <Expander Header="기준 정답·해설 (없으면 비워 두세요)" IsExpanded="False" Foreground="#52627A"><StackPanel Margin="0,16,0,0">
                            <TextBlock Text="기준 정답" Style="{StaticResource Label}"/><TextBox x:Name="AnswerInput" TextChanged="InputChanged"/>
                            <TextBlock Text="기준 해설" Style="{StaticResource Label}"/><TextBox x:Name="ExplanationInput" MinHeight="86" AcceptsReturn="True" MaxLength="12000" TextChanged="InputChanged"/>
                            <TextBlock Text="풀이 단계 3개" Style="{StaticResource Label}"/>
                            <TextBox x:Name="StepOneInput" TextChanged="InputChanged"/><TextBox x:Name="StepTwoInput" TextChanged="InputChanged"/><TextBox x:Name="StepThreeInput" TextChanged="InputChanged"/>
                        </StackPanel></Expander>
                        <Expander Header="API 없이 화면만 시험하기" Foreground="#718096" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><WrapPanel><Button x:Name="ExampleOneButton" Content="암모니아 예시" Click="ExampleOneClick"/><Button Content="Mg 연소 예시" Click="ExampleTwoClick"/><Button x:Name="DemoButton" Content="고정 예시 시연" Click="DemoClick"/></WrapPanel><TextBlock Text="이 시연 버튼만 고정 템플릿을 사용합니다. 내 파일 변형은 위의 실제 생성 버튼을 사용하세요." FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Expander>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" Padding="22,16" Background="#F9FBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0"><DockPanel>
                        <Button x:Name="GenerateButton" Content="변형 문제 생성  →" Background="#087F70" BorderBrush="#087F70" Foreground="White" FontWeight="Bold" Click="GenerateClick"/>
                        <Button x:Name="SaveButton" Content="저장" Click="SaveClick"/><Button x:Name="CancelButton" Content="취소" Visibility="Collapsed" Click="CancelClick"/>
                    </DockPanel></Border>
                </Grid></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="12"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="22,18" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="02  변형 결과" FontWeight="Bold" FontSize="17"/><TextBlock x:Name="ResultBadge" Text="생성 대기" Foreground="#087F70" FontSize="12" HorizontalAlignment="Right"/></DockPanel></Border>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="EmptyResult" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
                            <TextBlock x:Name="FeedbackIcon" Text="✧" FontSize="44" Foreground="#A2CFC5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FeedbackTitle" Text="새 문제가 여기에 나타납니다" FontSize="20" FontWeight="Bold" Margin="0,14,0,10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
                            <TextBlock x:Name="EmptyHint" Text="왼쪽에서 내 파일을 선택하고 ‘변형 문제 생성’을 눌러 주세요." Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
                            <ProgressBar x:Name="GenerationProgress" IsIndeterminate="True" Width="220" Height="5" Margin="0,18,0,0" Visibility="Collapsed"/>
                            <Button x:Name="InlineSettingsButton" Content="로컬 AI 연결 설정" Click="SettingsClick" Margin="0,20,0,0" Visibility="Collapsed" Background="#087F70" Foreground="White"/>
                            <Button x:Name="RetryGenerationButton" Content="다시 생성" Click="GenerateClick" Margin="0,20,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="22,20">
                            <Border Background="#EDF8F4" CornerRadius="7" Padding="12" Margin="0,0,0,20"><TextBlock x:Name="ChangeText" Foreground="#167865" FontSize="12" TextWrapping="Wrap"/></Border>
                            <Expander x:Name="SourceProblemPanel" Header="생성에 사용한 기준 자료" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="SourceProblemText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#64748B"/></Expander>
                            <TextBlock x:Name="ResultTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="ResultBody" FontSize="16" LineHeight="28" TextWrapping="Wrap" Margin="0,16,0,18"/><StackPanel x:Name="ResultFigures"/>
                            <ItemsControl x:Name="ChoicesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F6F8FB" CornerRadius="7" Padding="14,11" Margin="0,0,0,7"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Border Background="#ECF8F3" CornerRadius="8" Padding="16" Margin="0,16,0,18"><StackPanel><TextBlock Text="정답 · 검토 전" Foreground="#417462" FontSize="12"/><TextBlock x:Name="ResultAnswer" FontSize="24" FontWeight="Bold" Foreground="#087F70" Margin="0,5,0,0"/></StackPanel></Border>
                            <TextBlock Text="해설" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="ResultExplanation" TextWrapping="Wrap" LineHeight="25" Foreground="#52627A" Margin="0,10,0,18"/>
                            <TextBlock Text="풀이 흐름" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="ResultSteps" TextWrapping="Wrap" LineHeight="25" Foreground="#52627A" Margin="0,10,0,12"/>
                        </StackPanel></ScrollViewer>
                    </Grid>
                    <Border Grid.Row="2" Padding="22,16" Background="#F9FBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0"><WrapPanel><Button x:Name="CopyButton" Content="문제·해설 복사" IsEnabled="False" Click="CopyClick"/><Button x:Name="PdfButton" Content="PDF 미리보기" IsEnabled="False" Click="PdfClick"/></WrapPanel></Border>
                </Grid></Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="28,10"><TextBlock x:Name="StatusText" Text="준비 중…" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
